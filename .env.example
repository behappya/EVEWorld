# Copy to .env and fill in the values you need. Everything here is optional:
# training on the DreamGen recipe, RoboTwin and the offline parts of the
# evaluation suite run without any of these variables set.

# --- Model / dataset hubs -------------------------------------------------
# Cache for HuggingFace backbones (GigaWorld-0 weights, Qwen3-VL, SAM2, ...).
HF_HOME=/path/to/hf_cache
# Where `scripts/setup/download_models.sh` drops the released checkpoints.
EVEWORLD_CHECKPOINT_ROOT=/path/to/checkpoints

# --- Third-party checkouts ------------------------------------------------
# Only needed when you keep the backbones outside third_party/.
GIGA_MODELS_DIR=/path/to/giga-models
GIGA_MODELS_CACHE=/path/to/giga-models-cache
GIGA_MODELS_REPO_CACHE=/path/to/giga-models-repo-cache
FLOWWAM_ROOT=/path/to/FlowWAM

# --- Grounding / tracking -------------------------------------------------
GROUNDING_DINO_CONFIG=/path/to/GroundingDINO_SwinT_OGC.py
GROUNDING_DINO_WEIGHTS=/path/to/groundingdino_swint_ogc.pth
SAM2_CHECKPOINT=/path/to/sam2.1_hiera_large.pt

# --- Instruction-following judges ----------------------------------------
# Qwen-IF runs locally; the GPT and Gemini arms need an API key each.
OPENAI_API_KEY=
GOOGLE_API_KEY=
# Local Qwen3-VL judge used by the Qwen-IF arm.
QWEN_IF_MODEL=/path/to/Qwen3-VL-8B-Instruct

# --- Data roots -----------------------------------------------------------
DREAMGEN_DATA_ROOT=/path/to/dreamgen
AGIBOT_DATA_ROOT=/path/to/agibot
ROBOTWIN_DATA_ROOT=/path/to/robotwin
WORLDARENA_DATA_ROOT=/path/to/worldarena
